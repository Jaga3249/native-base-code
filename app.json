{
  "expo": {
    "name": "healthcare-app",
    "slug": "healthcare-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "healthcareapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "fonts": [
        {
          "fontFamily": "Montserrat",
          "fontDefinitions": [
            {
              "path": "./assets/fonts/Montserrat-Thin.ttf",
              "weight": 100,
              "style": "normal"
            },
            {
              "path": "./assets/fonts/Montserrat-ExtraLight.ttf",
              "weight": 200,
              "style": "normal"
            },
            {
              "path": "./assets/fonts/Montserrat-Light.ttf",
              "weight": 300,
              "style": "normal"
            },
            {
              "path": "./assets/fonts/Montserrat-Regular.ttf",
              "weight": 400,
              "style": "normal"
            },
            {
              "path": "./assets/fonts/Montserrat-Medium.ttf",
              "weight": 500,
              "style": "normal"
            },
            {
              "path": "./assets/fonts/Montserrat-Bold.ttf",
              "weight": 700,
              "style": "normal"
            },
            {
              "path": "./assets/fonts/Montserrat-ExtraBold.ttf",
              "weight": 800,
              "style": "normal"
            },
            {
              "path": "./assets/fonts/Montserrat-Black.ttf",
              "weight": 900,
              "style": "normal"
            }
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
